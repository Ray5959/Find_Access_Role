# 多合约配置，可以指定多个合约地址（用逗号分隔）进行分析
CONTRACT_ADDRESS=0x1111111111111111111111111111111111111111

# 节点RPC URL - 使用之前工作正常的RPC节点
RPC_URL=

# 网络设置 设置其中一个就行
CHAIN_ID=10
NETWORK_NAME=optimism

# 角色定义，会自动计算角色ID
# 可以定义为true来自动生成角色哈希
MINTER_ROLE=true
# 也可以直接指定角色字符串，会计算相应的哈希
FREEZER_ROLE=FREEZER_ROLE
# 也可以直接指定角色哈希（0x开头）
PAUSER_ROLE=0x65d7a28e3265b37a6474929f336521b332c1681b933f6cb9f3376673440d862a

# 分析控制
START_BLOCK=47388486
FORCE_REANALYSIS=true

# 测试模式 - 开启后会限制扫描区块范围，速度更快
TEST_MODE=false
TEST_BLOCK_RANGE=5000
